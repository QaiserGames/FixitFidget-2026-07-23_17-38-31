  streets:
  - id: west
    name: West Street
    where: "Between the caf\xE9's street-side windows and the bay-window houses (Grace's
      saffron house is on it)."
  - id: east
    name: East Street
    where: Past the courtyard, in front of the courtyard shops.
  - id: front
    name: Front Street
    where: "In front of the caf\xE9's door, with the caf\xE9's car park across it."
  - id: back
    name: Back Street
    where: "Behind the caf\xE9, at the far end of the west and east streets."
