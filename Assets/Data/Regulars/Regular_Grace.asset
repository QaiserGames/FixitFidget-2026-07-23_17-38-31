  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 97892a325f0d8524eaf01f70a23c9b44, type: 3}
  m_Name: Regular_Grace
  m_EditorClassIdentifier: Assembly-CSharp::CustomerProfile
  characterName: Grace
  bio: A retired school photographer with warm manners and exacting standards. Her
    family is gathering for the first time in years, and she wants every memory preserved.
  themeColor: {r: 0.83137256, g: 0.63529414, b: 0.22745098, a: 1}
  persistentId: grace
  homeId: home.grace
  standInLook: Character_BusinessWoman
  portraitNeutral: {fileID: 0}
  portraitHappy: {fileID: 0}
  portraitAnnoyed: {fileID: 0}
  portraitSad: {fileID: 0}
  portraitSurprised: {fileID: 0}
  patienceMultiplier: 1.15
  tipMultiplier: 1.1
  movementProfile: {fileID: 11400000, guid: 9f2df0a80345eac4cad5a97127771b19, type: 2}
  preferredWaitKind: 1
  drinkWishChance: 1
  primaryVisitKind: 2
  preferredDrink: {fileID: 11400000, guid: b7cb77bae0a35e04c998dece9a1f9fe4, type: 2}
  preferredDevice: {fileID: 0}
  preferredDeviceChance: 0
  storyteller: 1
  storyLines:
  - "My brother takes every family photograph. Funny\u2014he's never in the embarrassing ones."
  - We tried arranging everyone by height once. Auntie Rose climbed onto a chair.
    She's eighty-three.
  - The best photographs happen just after someone says the photograph is over.
  storyFirstDelay: 12
  storyInterval: 22
  storyMaxLines: 3
  focusReply: Of course, dear. I'll save the next chapter for your tea break.
  focusReturnLine: I was going to... Later. You need quiet. Is now a good time?
  lines:
    intake:
    - "My {device}: {fault}. It has to survive a family reunion."
    accepted:
    - "Thank you. Everyone in my family pretends they hate photographs\u2014until
      somebody forgets to take them."
    completed:
    - "There we are. You've rescued an argument my family hasn't had yet."
    declined:
    - I understand. I suppose every family reunion needs at least one disappointment.
    reassured:
    - That helps, dear. I can wait a little longer when someone remembers I'm here.
    stormedOut:
    - I have waited long enough. The reunion will not postpone itself for either
      of us.
    orderedDrink:
    - "My usual latte, please. No sugar."
  returnLines:
    intake:
    - "We've met before. My {device}: {fault}.\nSecond chances should work both ways."
    accepted:
    - All right. Let us see what we can do differently this time.
    completed:
    - Much better. I was hoping our first meeting wasn't the whole story.
    declined:
    - Twice tells me more than once. I will remember that.
    reassured:
    - Thank you for saying so. Being acknowledged does make a difference.
    stormedOut:
    - I gave this another chance. I will not make the same mistake a third time.
    orderedDrink:
    - A latte, please. If nothing else, let us get that part right.
  warmLines:
    intake:
    - "There you are! Your repair earned compliments nobody will admit giving.\nThis time it's my {device}: {fault}."
    accepted:
    - "I knew I came back to the right counter."
    completed:
    - Wonderful. At this rate, my family will start breaking things just to visit
      you.
    declined:
    - A pity, but you were honest with me. That still counts for something.
    reassured:
    - You remembered. That is worth more than a faster clock.
    stormedOut:
    - I trusted you with my time this time. Please do not make me regret that.
    orderedDrink:
    - A latte, please. No sugar. Life provides enough of that.
  returnMemoryLines:
    successfulRepair:
    - "There you are! Thank you for the care last time.\nToday's patient is my {device}: {fault}."
    imperfectRepair:
    - "The last repair had rough edges. More care this time? My {device}: {fault}."
    rejectedRepair:
    - "I took the last repair home unfinished. This time, my {device}: {fault}."
    incompleteService:
    - "We only sorted part of my order last time. Today, my {device}: {fault}."
    missedVisit:
    - 'We ran out of time last visit. I''d like to try again: this {device} has {fault}.'
    declinedVisit:
    - You couldn't take my job last time. Have you room today? My {device} has {fault}.
    capacityRefusal:
    - You didn't have what you needed last time. Shall we try again? My {device}
      has {fault}.
    servedVisit:
    - 'It''s good to see a familiar counter. Today it''s my {device}: {fault}.'
  passableRepairLines:
  - It will do, dear, though I had hoped for a little more care.
  rejectedRepairLines:
  - This still needs work. I'll take it home for now.
  drinkCompletedLines:
  - Thank you, dear. A little comfort goes a long way.
