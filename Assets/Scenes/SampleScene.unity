  archetypes:
  - archetypeName: Radio Owner
    patienceMultiplier: 1
    tipMultiplier: 1
    moodColor: {r: 1, g: 1, b: 1, a: 1}
    lines:
      intake:
      - Two days old. Brand new. Already broken.
      accepted:
      - Thank God. I was about to sell it on Marketplace.
      completed:
      - "You, my friend \u2014 chef's kiss. Thank you."
      declined:
      - Alright, I'll just sell it. Want a broken {device}?
      reassured:
      - Do your magic. I trust you.
      stormedOut:
      - Why waste my time. This place sucks.
  - archetypeName: WatchOwner
    patienceMultiplier: 1.3
    tipMultiplier: 1.4
    moodColor: {r: 1, g: 1, b: 1, a: 1}
    lines:
      intake:
      - This {device} was my dad's. I want it working again.
      accepted:
      - Thank you. I think he'd love that.
      completed:
      - Oh my god. It looks brand new.
      declined:
      - Oh. Okay. Sorry to bother you.
      reassured:
      - No rush at all. Take your time.
      stormedOut:
      - I'll... come back another time. Maybe.
  - archetypeName: PhoneOwner
    patienceMultiplier: 0.9
    tipMultiplier: 1
    moodColor: {r: 1, g: 1, b: 1, a: 1}
    lines:
      intake:
      - I drove over my {device}. Don't ask.
      accepted:
      - Thank you. It's the BananaPhone 20 Pro Max.
      completed:
      - Let's go! My BananaPhone looks brand new.
      declined:
      - You're just mad you don't have the BananaPhone 20 Pro Max.
      reassured:
      - Just don't break my BananaPhone 20 Pro Max.
      stormedOut:
      - Forget you guys. I'm getting the PineappleUltra 30.
